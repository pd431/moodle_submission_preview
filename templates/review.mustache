{{!
    @template local_submissioncheck/review

    The review page for an assignment upload: when it was submitted and the window, the disclaimer, a tab per file
    (when there are several) with what we found and the facts beside the preview, and the two answers in a bar fixed
    to the bottom of the window. Without JavaScript every file shows, one after another.

    Example context (json):
    {
        "uniqid": "local-submissioncheck-1", "cmid": 5, "heading": "Check your submission",
        "submitted": "You submitted this file at 11:58.", "awaiting": true, "multiple": false, "viewed": "",
        "windowmessage": "Check this report thoroughly.", "disclaimer": "Approximate preview.", "files": [],
        "confirmby": "Confirm by 12:13",
        "actions": {"url": "#", "sesskey": "x", "uploadid": 1, "confirmlabel": "Yes", "backlabel": "No",
            "backdisabled": false, "backreason": ""}
    }
}}
<section id="{{uniqid}}" class="local-submissioncheck local-submissioncheck-review" aria-labelledby="{{uniqid}}-heading"
         data-region="local-submissioncheck-review" data-cmid="{{cmid}}" {{#pending}}data-pending="1"{{/pending}}>
    <h2 id="{{uniqid}}-heading" class="h3">{{heading}}</h2>
    {{#continuing}}
    <p class="alert alert-primary"><strong>{{continuingmessage}}</strong></p>
    {{/continuing}}
    <p class="mb-1">{{submitted}}</p>
    {{#awaiting}}<p>{{windowmessage}}</p>{{/awaiting}}
    {{#statusmessage}}<p class="alert alert-success">{{statusmessage}}</p>{{/statusmessage}}
    {{#latemessage}}<p class="alert alert-warning">{{latemessage}}</p>{{/latemessage}}
    <p class="local-submissioncheck-disclaimer alert alert-info">{{disclaimer}}</p>

    {{#multiple}}
    <div class="local-submissioncheck-tabs" role="tablist" aria-label="{{#str}}reviewfiles, local_submissioncheck{{/str}}"
         data-region="local-submissioncheck-tabs">
        {{#files}}
        <button type="button" class="local-submissioncheck-tab {{#haswarnings}}local-submissioncheck-tab-warning{{/haswarnings}}"
                role="tab" id="{{uniqid}}-tab-{{index}}" aria-controls="{{uniqid}}-panel-{{index}}" data-filename="{{name}}"
                aria-selected="{{#first}}true{{/first}}{{^first}}false{{/first}}" {{^first}}tabindex="-1"{{/first}}>
            {{#haswarnings}}{{#pix}}i/warning, core{{/pix}}{{/haswarnings}}
            {{^haswarnings}}{{#pix}}i/valid, core{{/pix}}{{/haswarnings}}
            <span class="local-submissioncheck-tabname">{{name}}</span>
            <span class="local-submissioncheck-tabstatus">{{tabstatus}}</span>
        </button>
        {{/files}}
    </div>
    {{/multiple}}

    {{#files}}
    <div class="local-submissioncheck-file" data-region="local-submissioncheck-file"
         {{#multiple}}role="tabpanel" id="{{uniqid}}-panel-{{index}}" aria-labelledby="{{uniqid}}-tab-{{index}}" tabindex="0"{{/multiple}}>
        <div class="local-submissioncheck-side">
            <h3 class="h5">{{#str}}reviewfound, local_submissioncheck{{/str}}</h3>
            {{> local_submissioncheck/file_checks }}
            {{> local_submissioncheck/file_facts }}
            <p class="small text-muted mb-3">{{#str}}reviewapprox, local_submissioncheck{{/str}}</p>
        </div>
        <div class="local-submissioncheck-main">
            <h3 class="h5">{{#str}}reviewlook, local_submissioncheck{{/str}}</h3>
            {{> local_submissioncheck/file_preview }}
        </div>
    </div>
    {{/files}}

    {{#actions}}
    <div class="local-submissioncheck-bar" data-region="local-submissioncheck-bar">
        <p class="local-submissioncheck-barinfo mb-0">
            <strong>{{confirmby}}</strong>
            {{#multiple}}<span class="local-submissioncheck-viewed" data-region="local-submissioncheck-viewed">{{viewed}}</span>{{/multiple}}
        </p>
        <form method="post" action="{{url}}" class="local-submissioncheck-actions d-flex flex-wrap align-items-start">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="uploadid" value="{{uploadid}}">
            <button type="submit" name="action" value="confirm" class="btn btn-primary">{{confirmlabel}}</button>
            <button type="submit" name="action" value="back" class="btn btn-secondary"
                {{#backdisabled}}disabled aria-describedby="{{uniqid}}-backreason"{{/backdisabled}}>{{backlabel}}</button>
        </form>
        {{#backdisabled}}<p id="{{uniqid}}-backreason" class="local-submissioncheck-backreason text-muted mb-0">{{backreason}}</p>{{/backdisabled}}
    </div>
    {{/actions}}
</section>
