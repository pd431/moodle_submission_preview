{{!
    @template local_submissioncheck/missing_item

    A picture, video or sound file the document only links to, drawn where it would be: a thick red border and red
    hatching, with the broken-file icon and the message on a white panel so the hatching never sits behind the text.
    Styles are inline because it is drawn inside sandboxed previews that load no stylesheet. The icon is Font Awesome
    Free 6.5.2 "file-circle-xmark" (CC BY 4.0, https://fontawesome.com/license/free), inlined for the same reason.

    Example context (json):
    {
        "message": "graph1.png is not included in this document. A marker will not see it.",
        "width": "320px", "height": "180px"
    }
}}
<div class="local-submissioncheck-missing" data-region="local-submissioncheck-missing" style="box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: {{#width}}{{width}}{{/width}}{{^width}}100%{{/width}}; max-width: 100%; min-height: {{#height}}{{height}}{{/height}}{{^height}}120px{{/height}}; margin: 8px 0; padding: 16px; border: 5px solid #b00020; background-color: #fff; background-image: repeating-linear-gradient(45deg, #b00020 0, #b00020 3px, #fbe3e7 3px, #fbe3e7 14px);">
    <p style="display: flex; align-items: center; gap: 10px; margin: 0; padding: 10px 14px; max-width: 34em; background: #fff; border-radius: 4px; color: #b00020; font: 600 15px/1.4 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; text-indent: 0; text-align: left;">
        <svg aria-hidden="true" focusable="false" width="28" height="25" viewBox="0 0 576 512" style="flex-shrink: 0;"><path fill="#b00020" d="M0 64C0 28.7 28.7 0 64 0H224V128c0 17.7 14.3 32 32 32H384v38.6C310.1 219.5 256 287.4 256 368c0 59.1 29.1 111.3 73.7 143.3c-3.2 .5-6.4 .7-9.7 .7H64c-35.3 0-64-28.7-64-64V64zm384 64H256V0L384 128zm48 96a144 144 0 1 1 0 288 144 144 0 1 1 0-288zm59.3 107.3c6.2-6.2 6.2-16.4 0-22.6s-16.4-6.2-22.6 0L432 345.4l-36.7-36.7c-6.2-6.2-16.4-6.2-22.6 0s-6.2 16.4 0 22.6L409.4 368l-36.7 36.7c-6.2 6.2-6.2 16.4 0 22.6s16.4 6.2 22.6 0L432 390.6l36.7 36.7c6.2 6.2 16.4 6.2 22.6 0s6.2-16.4 0-22.6L454.6 368l36.7-36.7z"></path></svg>
        <span>{{message}}</span>
    </p>
</div>
