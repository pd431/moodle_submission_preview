{{!
    @template local_submissioncheck/banner

    The short banner the assignment page keeps: while the student still has to answer, when it was submitted, the
    confirm-by time and the way back to the review page; afterwards, the outcome, any warnings, and a link to the
    report.

    Example context (json):
    {
        "uniqid": "local-submissioncheck-1", "heading": "Check your submission", "awaiting": true,
        "submitted": "You submitted this file at 11:58.", "confirmby": "Confirm by 12:13", "reviewurl": "#",
        "statusmessage": "", "latemessage": "", "files": []
    }
}}
<section class="local-submissioncheck local-submissioncheck-banner card mb-3" aria-labelledby="{{uniqid}}-heading"
         data-region="local-submissioncheck-banner">
    <div class="card-body">
        <h2 id="{{uniqid}}-heading" class="h4 card-title">{{heading}}</h2>
        {{#awaiting}}
        <p class="mb-2">{{submitted}} <strong>{{confirmby}}</strong></p>
        <a class="btn btn-primary" href="{{reviewurl}}">{{#str}}continuechecking, local_submissioncheck{{/str}}</a>
        {{/awaiting}}
        {{^awaiting}}
        <p class="mb-1">{{submitted}}</p>
        {{#statusmessage}}<p class="alert alert-success">{{statusmessage}}</p>{{/statusmessage}}
        {{#latemessage}}<p class="alert alert-warning">{{latemessage}}</p>{{/latemessage}}
        {{#files}}{{#hasfindings}}{{> local_submissioncheck/file_checks }}{{/hasfindings}}{{/files}}
        <p class="mb-0"><a href="{{reviewurl}}">{{#str}}seereport, local_submissioncheck{{/str}}</a></p>
        {{/awaiting}}
    </div>
</section>
