{{!
    @template local_submissioncheck/file_facts

    Facts about one file, read from the file itself.

    Example context (json):
    {"factslabel": "About essay.docx", "facts": [{"label": "Kind", "value": "Word document"}, {"label": "Pages", "value": "2"}]}
}}
<div class="local-submissioncheck-facts mb-3" role="region" aria-label="{{factslabel}}">
    <h4 class="h6 mb-1">{{#str}}factaboutheading, local_submissioncheck{{/str}}</h4>
    <dl class="local-submissioncheck-factlist mb-0">
        {{#facts}}
        <dt>{{label}}</dt>
        <dd>{{value}}</dd>
        {{/facts}}
    </dl>
</div>
