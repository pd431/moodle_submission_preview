{{!
    @template local_submissioncheck/files

    Check results and facts, then the approximate-preview notice, then a preview of each file, stacked (quiz).

    Example context (json):
    {
        "disclaimer": "This is an approximate preview of your document(s).",
        "files": [{
            "name": "essay.docx", "checkslabel": "Submission checks for essay.docx", "previewlabel": "Preview of essay.docx",
            "ok": true, "okmessage": "No problems found in essay.docx", "hasfindings": false, "findings": [],
            "previewready": true, "previewpdf": true, "previewurl": "#", "openpreview": "Open the preview of essay.docx"
        }]
    }
}}
{{#files}}
{{> local_submissioncheck/file_checks }}
{{> local_submissioncheck/file_facts }}
{{/files}}
<p class="local-submissioncheck-disclaimer alert alert-info">{{disclaimer}}</p>
{{#files}}
{{> local_submissioncheck/file_preview }}
{{/files}}
