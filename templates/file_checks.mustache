{{!
    @template local_submissioncheck/file_checks

    One file's check results.

    Example context (json):
    {"name": "essay.docx", "checkslabel": "Submission checks for essay.docx", "ok": true,
        "okmessage": "No problems found in essay.docx", "hasfindings": false, "findings": []}
}}
<div class="local-submissioncheck-checks mb-3" role="region" aria-label="{{checkslabel}}">
    {{#ok}}
    <p class="local-submissioncheck-ok mb-1"><i class="icon fa fa-check text-success" aria-hidden="true"></i>{{okmessage}}</p>
    {{/ok}}
    {{#hasfindings}}
    <div class="alert alert-warning mb-1">
        <p class="mb-1"><strong>{{name}}</strong></p>
        {{#findings}}
        <p class="mb-1">{{message}}</p>
        {{#hasitems}}
        <ul class="mb-1">
            {{#items}}<li>{{name}}</li>{{/items}}
        </ul>
        {{/hasitems}}
        {{/findings}}
    </div>
    {{/hasfindings}}
    {{#checksunavailable}}
    <p class="alert alert-info mb-1">{{checksunavailablemessage}}</p>
    {{/checksunavailable}}
    {{#incomplete}}
    <p class="text-muted mb-1">{{incompletemessage}}</p>
    {{/incomplete}}
</div>
